{
  "name": "bolt-inspect-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "볼트 타음 검사 안드로이드 앱 (web/app 을 Capacitor 로 감싼 것)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "serve": "node scripts/build-web.mjs && node scripts/serve.mjs",
    "test": "node scripts/test-logic.mjs",
    "android:add": "node scripts/build-web.mjs && cap add android",
    "android:sync": "node scripts/build-web.mjs && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2"
  }
}
