{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bolt-inspect/inspection/1.1",
  "title": "inspections/{record_id} - 검사 1건 (스키마 v1.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "type",
    "flange_id",
    "bolt_id",
    "inspector",
    "device_id",
    "inspected_at",
    "vision",
    "gap",
    "tapping",
    "final_result",
    "app_version"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^FL[0-9]{3}-(B[0-9]{2}|GAP)-[0-9]{14}$",
      "description": "플랜지-볼트-YYYYMMDDHHMMSS. 문서 ID와 같아야 함"
    },
    "type": {
      "enum": [
        "BOLT",
        "GAP"
      ],
      "description": "BOLT=볼트 1개 검사, GAP=플랜지 틈 4지점 검사"
    },
    "flange_id": {
      "type": "string",
      "pattern": "^FL[0-9]{3}$"
    },
    "bolt_id": {
      "type": "string",
      "pattern": "^(B[0-9]{2}|GAP)$",
      "description": "12시 방향부터 시계방향 B01, B02 ... / 틈 검사는 GAP"
    },
    "inspector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "예: TAB-01"
    },
    "inspected_at": {
      "type": "string",
      "format": "date-time",
      "description": "한국시간 ISO 문자열. 예: 2026-10-14T10:32:05+09:00"
    },
    "vision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protrusion_mm",
            "thread_count",
            "confidence",
            "crop_jpg_b64",
            "result"
          ],
          "properties": {
            "protrusion_mm": {
              "type": "number",
              "minimum": -50,
              "maximum": 100,
              "description": "너트 윗면~볼트 끝. 음수 = 볼트가 너트 안에 묻힘"
            },
            "thread_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 50
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "crop_jpg_b64": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 140000,
              "description": "볼트 부분만 자른 JPEG의 base64 (약 100KB 이하). 없으면 null"
            },
            "result": {
              "$ref": "#/$defs/result"
            }
          }
        }
      ]
    },
    "gap": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gap_mm",
            "gap_diff_mm",
            "result"
          ],
          "properties": {
            "gap_mm": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "description": "[12시, 3시, 6시, 9시] 순서 고정"
            },
            "gap_diff_mm": {
              "type": "number",
              "minimum": 0,
              "description": "max(gap_mm) - min(gap_mm)"
            },
            "result": {
              "$ref": "#/$defs/result"
            }
          }
        }
      ]
    },
    "tapping": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_hz",
            "decay_ms",
            "score",
            "model",
            "result"
          ],
          "properties": {
            "peak_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "decay_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "description": "rule: σ 배수 / range: 범위를 벗어난 특징값 개수(0~6) / rf: 이상 확률"
            },
            "model": {
              "enum": [
                "rule",
                "range",
                "rf"
              ],
              "description": "rule=기준 주파수와의 σ 거리, range=특징값 범위 판정(v1.1), rf=학습 모델"
            },
            "result": {
              "$ref": "#/$defs/result"
            },
            "features": {
              "description": "v1.1: 센서별 특징값. mic=INMP441 음향, acc=MPU6050 진동(없으면 null)",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mic",
                    "acc"
                  ],
                  "properties": {
                    "mic": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "peak_hz",
                        "mag",
                        "energy_pct"
                      ],
                      "properties": {
                        "peak_hz": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "mag": {
                          "type": "number",
                          "minimum": 0
                        },
                        "energy_pct": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      }
                    },
                    "acc": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "peak_hz",
                            "mag",
                            "energy_pct"
                          ],
                          "properties": {
                            "peak_hz": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "mag": {
                              "type": "number",
                              "minimum": 0
                            },
                            "energy_pct": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "checks": {
              "description": "v1.1: 특징값별 기준 범위 안(true)/밖(false). 판정 근거",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mic",
                    "acc"
                  ],
                  "properties": {
                    "mic": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "peak_hz",
                        "mag",
                        "energy_pct"
                      ],
                      "properties": {
                        "peak_hz": {
                          "type": "boolean"
                        },
                        "mag": {
                          "type": "boolean"
                        },
                        "energy_pct": {
                          "type": "boolean"
                        }
                      }
                    },
                    "acc": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "peak_hz",
                            "mag",
                            "energy_pct"
                          ],
                          "properties": {
                            "peak_hz": {
                              "type": "boolean"
                            },
                            "mag": {
                              "type": "boolean"
                            },
                            "energy_pct": {
                              "type": "boolean"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "sensor_results": {
              "description": "v1.1: 센서별 판정",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mic",
                    "acc"
                  ],
                  "properties": {
                    "mic": {
                      "$ref": "#/$defs/result"
                    },
                    "acc": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/$defs/result"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "ref_source": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "description": "v1.1: 어떤 기준으로 판정했는지. 예: 실측 등록 n=10 ±2σ"
            }
          }
        }
      ]
    },
    "final_result": {
      "$ref": "#/$defs/result",
      "description": "vision/gap/tapping 중 가장 나쁜 값 (NG > CHECK > OK)"
    },
    "note": {
      "type": "string",
      "maxLength": 200
    },
    "app_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  },
  "$defs": {
    "result": {
      "enum": [
        "OK",
        "CHECK",
        "NG"
      ]
    }
  }
}